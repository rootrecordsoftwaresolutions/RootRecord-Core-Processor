[Unit]
Description=AVA Server GitHub fast-forward pull
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ava
Group=ava
WorkingDirectory=/opt/rootrecord-core-processor
Environment=AVA_REPO=/opt/rootrecord-core-processor
Environment=AVA_LOG_DIR=/var/log/ava-server
ExecStart=/usr/bin/python3 /opt/rootrecord-core-processor/scripts/auto-pull-server.py check
